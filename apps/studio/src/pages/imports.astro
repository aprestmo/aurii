---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Imports" active="imports">
  <h1>Saved imports</h1>
  <p class="muted">Run saved definitions (dry or persist). Toggle schedules. History includes errors from Core.</p>
  <div id="defs" class="card" style="margin-top: 1rem;">Loading…</div>
  <h2 style="margin-top: 2rem;">Import history</h2>
  <div id="history" class="card">Loading…</div>
</Layout>

<script>
  import { api, getDataset } from "../lib/api";

  type Project = { id: string; slug: string };
  type SavedImport = {
    id: string;
    name: string;
    schemaId: string;
    status: string;
    triggerMode: string;
    schedule: {
      enabled: boolean;
      spec: { expression: string; timezone?: string };
      nextRunAt: string | null;
      lastRunAt: string | null;
    } | null;
  };
  type Run = {
    id: string;
    definitionId: string | null;
    status: string;
    dryRun: boolean;
    total: number;
    imported: number;
    failed: number;
    errors: unknown[];
    startedAt: string | null;
    completedAt: string | null;
  };

  const projectSlug = localStorage.getItem("aurii.projectSlug");
  const projects = await api<{ data: Project[] }>("/api/projects");
  const project = projectSlug
    ? projects.data.find((p) => p.slug === projectSlug)
    : projects.data[0];
  const defsEl = document.getElementById("defs")!;
  const histEl = document.getElementById("history")!;

  function formatErrors(errors: unknown[]): string {
    if (!errors?.length) return "";
    return errors
      .slice(0, 5)
      .map((e) => {
        if (typeof e === "string") return e;
        if (e && typeof e === "object" && "message" in e) {
          return String((e as { message: unknown }).message);
        }
        return JSON.stringify(e);
      })
      .join("; ");
  }

  if (!project) {
    defsEl.textContent = "No project selected.";
    histEl.textContent = "";
  } else {
    const dataset = getDataset();
    const defs = await api<{ data: SavedImport[] }>(
      `/api/projects/${project.id}/saved-imports?dataset=${encodeURIComponent(dataset)}`,
    );
    if (!defs.data.length) {
      defsEl.innerHTML = "<p class='muted'>No saved imports. Run <code>register-via-api.ts</code> or create via API.</p>";
    } else {
      defsEl.innerHTML = defs.data
        .map(
          (d) => `<div class="row" style="display:flex;gap:0.75rem;align-items:center;margin-bottom:0.75rem;flex-wrap:wrap;">
            <div style="flex:1;min-width:200px">
              <strong>${d.name}</strong>
              <div class="muted" style="font-size:12px">${d.schemaId} · ${d.triggerMode} · ${d.status}
              ${d.schedule ? ` · cron ${d.schedule.spec.expression}${d.schedule.spec.timezone ? " (" + d.schedule.spec.timezone + ")" : ""}` : ""}
              ${d.schedule?.nextRunAt ? ` · next ${d.schedule.nextRunAt}` : ""}
              ${d.schedule?.lastRunAt ? ` · last ${d.schedule.lastRunAt}` : ""}
              </div>
            </div>
            ${
              d.schedule
                ? `<button data-sched="${d.id}" data-enabled="${d.schedule.enabled ? "0" : "1"}">${d.schedule.enabled ? "Disable schedule" : "Enable schedule"}</button>`
                : ""
            }
            <button data-id="${d.id}" data-dry="1">Dry run</button>
            <button data-id="${d.id}" data-dry="0">Run</button>
          </div>`,
        )
        .join("");

      defsEl.querySelectorAll("button[data-id]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-id")!;
          const dryRun = btn.getAttribute("data-dry") === "1";
          btn.setAttribute("disabled", "true");
          try {
            await api(`/api/projects/${project.id}/saved-imports/${id}/run`, {
              method: "POST",
              body: JSON.stringify({ dryRun }),
            });
            window.location.reload();
          } catch (e) {
            alert(e instanceof Error ? e.message : String(e));
            btn.removeAttribute("disabled");
          }
        });
      });

      defsEl.querySelectorAll("button[data-sched]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-sched")!;
          const enabled = btn.getAttribute("data-enabled") === "1";
          const def = defs.data.find((d) => d.id === id);
          if (!def?.schedule) return;
          btn.setAttribute("disabled", "true");
          try {
            await api(`/api/projects/${project.id}/saved-imports/${id}`, {
              method: "PATCH",
              body: JSON.stringify({
                schedule: {
                  ...def.schedule,
                  enabled,
                },
              }),
            });
            window.location.reload();
          } catch (e) {
            alert(e instanceof Error ? e.message : String(e));
            btn.removeAttribute("disabled");
          }
        });
      });
    }

    const hist = await api<Run[]>(`/imports?dataset=${encodeURIComponent(dataset)}&limit=20`);
    const rows = Array.isArray(hist) ? hist : [];
    histEl.innerHTML = rows.length
      ? `<table><thead><tr><th>Definition</th><th>Status</th><th>Dry</th><th>Total</th><th>Imported</th><th>Failed</th><th>Started</th><th>Errors</th></tr></thead>
         <tbody>${rows.map((r) => {
           const err = formatErrors(r.errors ?? []);
           return `<tr>
           <td>${r.definitionId ?? "—"}</td><td>${r.status}</td><td>${r.dryRun}</td>
           <td>${r.total}</td><td>${r.imported}</td><td>${r.failed}</td><td>${r.startedAt ?? "—"}</td>
           <td style="max-width:280px;font-size:12px;color:${err ? "var(--danger, #b33)" : "inherit"}">${err || "—"}</td>
         </tr>`;
         }).join("")}</tbody></table>`
      : "<p class='muted'>No runs yet.</p>";
  }
</script>
