{
	"name": "@aurii/validation",
	"version": "0.1.0",
	"description": "Aurii shared validation helpers",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aprestmo/aurii.git",
		"directory": "packages/validation"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__tests__",
		"README.md"
	],
	"module": "src/index.ts",
	"main": "src/index.ts",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./project": "./src/project.ts"
	},
	"scripts": {
		"build": "bun run typecheck",
		"test": "bun test src/__tests__",
		"typecheck": "tsc --noEmit",
		"lint": "bunx @biomejs/biome lint src/"
	},
	"dependencies": {
		"@aurii/types": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^6.0.3"
	}
}
