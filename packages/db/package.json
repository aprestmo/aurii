{
	"name": "@aurii/db",
	"version": "0.1.0",
	"description": "Aurii database schema, migrations, and seed (Drizzle)",
	"module": "src/index.ts",
	"main": "src/index.ts",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./schema/projects": "./src/schema/projects.ts"
	},
	"scripts": {
		"build": "bun run typecheck",
		"test": "bun test src/__tests__ 2>/dev/null || true",
		"typecheck": "tsc --noEmit",
		"lint": "bunx @biomejs/biome lint src/",
		"generate": "drizzle-kit generate",
		"migrate": "bun run scripts/migrate.ts",
		"seed": "bun run scripts/seed.ts"
	},
	"dependencies": {
		"@aurii/types": "workspace:*",
		"drizzle-orm": "^0.44.2",
		"postgres": "^3.4.7"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.3"
	}
}
