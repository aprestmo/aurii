# Live delivery (Astro product). Snapshot mode is the default when unset.
# AURII_CORE_URL=http://localhost:3000
# AURII_PROJECT_SLUG=norge-data
# AURII_DELIVERY_MODE=live

# Project-package registration against a running Aurii Runtime
# AURII_API_TOKEN=

# Storage for import / migrate scripts (defaults to SQLite)
# AURII_STORAGE=sqlite
# AURII_DB_PATH=./.tmp/aurii.sqlite
# DATABASE_URL=postgres://aurii:aurii@localhost:5432/aurii

# GitHub Pages / Astro
# ASTRO_SITE=https://aprestmo.github.io
# ASTRO_BASE=/norwegian-geo/
