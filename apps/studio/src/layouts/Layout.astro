---
interface Props {
  title: string;
  active: string;
}
const { title, active } = Astro.props;

import "../styles/global.css";
import { getStudioRuntimeEnv } from "../lib/env";
import {
	collectionColumnsBySchema,
	importGroupsFromConfig,
	navHref,
	navLabel,
	resolveActiveStudioConfig,
	routeGroupsFromConfig,
} from "../lib/studio-config";

const env = getStudioRuntimeEnv();
const { config: studioCfg, title: studioTitle } = await resolveActiveStudioConfig();
const groups = studioCfg.navigation ?? [];
const opsConfig = {
	importGroups: importGroupsFromConfig(studioCfg),
	routeGroups: routeGroupsFromConfig(studioCfg),
	featuredSchemas: studioCfg.featuredSchemas ?? [],
	collectionColumns: collectionColumnsBySchema(studioCfg),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {studioTitle}</title>
    <script is:inline define:vars={{ coreUrl: env.coreUrl, projectSlug: env.projectSlug, defaultDataset: env.defaultDataset }}>
      if (coreUrl && !localStorage.getItem("aurii.apiUrl")) {
        localStorage.setItem("aurii.apiUrl", coreUrl);
      }
      if (projectSlug) localStorage.setItem("aurii.projectSlug", projectSlug);
      if (defaultDataset && !localStorage.getItem("aurii.dataset")) {
        localStorage.setItem("aurii.dataset", defaultDataset);
      }
    </script>
  </head>
  <body>
    <div class="app">
      <nav class="sidebar">
        <div class="logo">au<span>rii</span> studio</div>
        {env.projectSlug && (
          <div class="muted" style="padding: 0 12px 8px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">
            {env.projectSlug}
          </div>
        )}
        {groups.map((group) => (
          <div class="nav-group">
            <div class="nav-group-title">{group.title}</div>
            {group.items.map((item) => {
              const href = navHref(item);
              const label = navLabel(item);
              const key = item.kind === "collection"
                ? `entities:${item.schemaId ?? ""}`
                : item.kind === "custom"
                  ? `view:${item.viewId ?? ""}`
                  : item.kind;
              const isActive =
                active === key ||
                (active === "dashboard" && item.kind === "dashboard") ||
                (active === "entities" && item.kind === "collection") ||
                (active === "sources" && item.kind === "sources") ||
                (active === "imports" && item.kind === "imports") ||
                (active === "routes" && item.kind === "apiRoutes") ||
                (active === "query" && item.kind === "query") ||
                (active === "schemas" && item.kind === "schemas") ||
                (active === "system" && item.kind === "system");
              return (
                <a href={href} class={isActive ? "active" : ""}>{label}</a>
              );
            })}
          </div>
        ))}
        <div class="spacer"></div>
        <div style="padding: 0 12px 12px;">
          <label for="dataset-switcher" class="muted" style="font-size: 11px;">DATASET</label>
          <select id="dataset-switcher"></select>
        </div>
        <div class="conn" id="conn-status">
          <span class="dot err"></span>connecting…
        </div>
      </nav>
      <main class="main">
        <script type="application/json" id="studio-ops-config" set:html={JSON.stringify(opsConfig)} />
        <slot />
      </main>
    </div>

    <script>
      import { api, checkHealth, getDataset, setDataset } from "../lib/api";
      import { writePolicyBanner } from "../lib/ops-format";

      const health = await checkHealth();
      const conn = document.getElementById("conn-status")!;
      if (health) {
        conn.innerHTML = `<span class="dot ok"></span>${health.storage} · connected`;
      } else {
        conn.innerHTML = `<span class="dot err"></span>API unreachable`;
      }

      try {
        type Project = { id: string; name: string; slug: string; status: string };
        type Dataset = { id: string; name: string; projectId: string };
        const projectSlug = localStorage.getItem("aurii.projectSlug");
        const projectsRes = await api<{ data: Project[] }>("/api/projects");
        let projects = projectsRes.data;
        if (projectSlug) {
          projects = projects.filter((p) => p.slug === projectSlug);
        }
        const currentProject = projects[0];
        const bannerText = writePolicyBanner(currentProject?.status);
        if (bannerText) {
          const banner = document.createElement("div");
          banner.className = "error-box";
          banner.setAttribute("data-write-policy", currentProject?.status ?? "");
          banner.textContent = bannerText;
          document.querySelector("main.main")?.prepend(banner);
        }
        const datasets: (Dataset & { projectSlug: string })[] = [];
        for (const project of projects) {
          const list = await api<{ data: Dataset[] }>(
            `/api/projects/${encodeURIComponent(project.id)}/datasets`,
          );
          for (const d of list.data) {
            datasets.push({ ...d, projectSlug: project.slug });
          }
        }
        const sel = document.getElementById("dataset-switcher") as HTMLSelectElement;
        const current = getDataset();
        sel.innerHTML = datasets
          .map(
            (d) =>
              `<option value="${d.id}" ${d.id === current ? "selected" : ""}>${d.name} (${d.projectSlug})</option>`,
          )
          .join("");
        sel.addEventListener("change", () => {
          setDataset(sel.value);
          window.location.reload();
        });
      } catch {
        /* login redirect handled by api() */
      }
    </script>
  </body>
</html>

<style>
  .nav-group { margin-bottom: 0.75rem; }
  .nav-group-title {
    padding: 0.35rem 12px;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.55;
  }
</style>
