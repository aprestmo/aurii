---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Sources" active="sources">
  <h1>Data sources</h1>
  <p class="muted">Origins of data flowing into Core. Secrets are never shown.</p>
  <div id="list" class="card" style="margin-top: 1rem;">Loading…</div>
</Layout>

<script>
  import { api, getDataset } from "../lib/api";

  type Project = { id: string; slug: string };
  type DataSource = {
    id: string;
    name: string;
    kind: string;
    status: string;
    datasetId: string;
    lastSuccessAt: string | null;
    lastFailureAt: string | null;
    nextRunAt: string | null;
    lastError: string | null;
    config: { targetSchemas?: string[]; endpoint?: string };
  };

  const projectSlug = localStorage.getItem("aurii.projectSlug");
  const projects = await api<{ data: Project[] }>("/api/projects");
  const project = projectSlug
    ? projects.data.find((p) => p.slug === projectSlug)
    : projects.data[0];
  const el = document.getElementById("list")!;
  if (!project) {
    el.textContent = "No project selected.";
  } else {
    const qs = `?dataset=${encodeURIComponent(getDataset())}`;
    const res = await api<{ data: DataSource[] }>(
      `/api/projects/${project.id}/sources${qs}`,
    );
    if (!res.data.length) {
      el.innerHTML = "<p class='muted'>No sources registered yet. Register via API or project bootstrap.</p>";
    } else {
      el.innerHTML = `<table><thead><tr>
        <th>Name</th><th>Kind</th><th>Status</th><th>Schemas</th><th>Last success</th><th>Next run</th><th>Error</th>
      </tr></thead><tbody>${res.data
        .map(
          (s) => `<tr>
          <td>${s.name}</td>
          <td>${s.kind}</td>
          <td>${s.status}</td>
          <td>${(s.config.targetSchemas ?? []).join(", ")}</td>
          <td>${s.lastSuccessAt ?? "—"}</td>
          <td>${s.nextRunAt ?? "—"}</td>
          <td>${s.lastError ?? "—"}</td>
        </tr>`,
        )
        .join("")}</tbody></table>`;
    }
  }
</script>
