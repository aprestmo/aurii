# Aurii Core — Docker image
# Multi-stage: install workspace deps, then run @aurii/api

FROM oven/bun:1 AS deps
WORKDIR /app

COPY package.json bun.lock ./
COPY packages/core/package.json ./packages/core/
COPY packages/db/package.json ./packages/db/
COPY packages/types/package.json ./packages/types/
COPY packages/validation/package.json ./packages/validation/
COPY packages/sdk/package.json ./packages/sdk/
COPY apps/api/package.json ./apps/api/

RUN mkdir -p apps/studio apps/geo && \
  printf '{"name":"@aurii/studio","private":true}\n' > apps/studio/package.json && \
  printf '{"name":"@aurii/geo","private":true}\n' > apps/geo/package.json

RUN bun install --frozen-lockfile

FROM oven/bun:1
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock ./
COPY packages/types ./packages/types
COPY packages/validation ./packages/validation
COPY packages/db ./packages/db
COPY packages/core ./packages/core
COPY apps/api ./apps/api

ENV PORT=3000
ENV AURII_STORAGE=postgres

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["bun", "run", "apps/api/src/index.ts"]
