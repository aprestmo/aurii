{
	"name": "@aurii/api",
	"version": "0.1.0",
	"description": "Aurii HTTP API — thin adapter over Core",
	"module": "src/index.ts",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"serve": "bun run src/index.ts",
		"dev": "bun --watch src/index.ts",
		"build": "bun run typecheck",
		"test": "bun test src/__tests__",
		"typecheck": "tsc --noEmit",
		"lint": "bunx @biomejs/biome lint src/"
	},
	"dependencies": {
		"@aurii/core": "workspace:*",
		"@aurii/db": "workspace:*",
		"@aurii/types": "workspace:*",
		"@aurii/validation": "workspace:*",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/swagger": "^1.3.1",
		"elysia": "^1.4.29"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^6.0.3"
	}
}
