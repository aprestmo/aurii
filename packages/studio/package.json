{
  "name": "@aurii/studio",
  "version": "0.1.0",
  "description": "Aurii Studio — declarative project configuration helpers",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aprestmo/aurii.git",
    "directory": "packages/studio"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test src/__tests__",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome lint src/",
    "build": "bun run typecheck"
  },
  "dependencies": {
    "@aurii/types": "workspace:*",
    "@aurii/validation": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
