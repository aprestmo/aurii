# Copy to deploy/.env (never commit the filled file).
# Used by deploy/compose.reference.yml

# --- Required ---
AURII_ENV=production
AURII_STORAGE=postgres
POSTGRES_USER=aurii
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=aurii
DATABASE_URL=postgres://aurii:replace-with-a-long-random-password@postgres:5432/aurii
AURII_API_TOKEN=replace-with-a-long-random-operator-token
AURII_CORS_ORIGINS=https://geo.example,https://studio.example

# --- Runtime ---
PORT=3000
AURII_UPLOAD_DIR=/tmp/aurii-uploads
AURII_ENABLE_SCHEDULER=1

# --- Release identity (CI usually injects these) ---
AURII_VERSION=0.1.0
AURII_GIT_SHA=unknown
AURII_BUILD_TIME=unknown

# --- Studio (optional service; bake the public API URL at image build) ---
PUBLIC_AURII_CORE_URL=https://api.example
PUBLIC_AURII_PROJECT_SLUG=
PUBLIC_AURII_DEFAULT_DATASET=

# --- Backups ---
BACKUP_DIR=/backups
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400
# Optional extra command after a successful dump (off-machine copy).
# Example: rclone copy /backups remote:aurii-backups
# BACKUP_UPLOAD_COMMAND=
