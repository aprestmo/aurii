---
import Layout from "../layouts/Layout.astro";
---
<Layout title="API routes" active="routes">
  <h1>Published API routes</h1>
  <p class="muted">Enable declarative delivery endpoints. Consumers call Core — not Studio. Groups come from <code>defineStudio</code>.</p>
  <div id="list" class="card" style="margin-top: 1rem;">Loading…</div>
</Layout>

<script>
  import { groupItemsByIds } from "@aurii/studio";
  import { api, getDataset, readStudioOpsConfig } from "../lib/api";

  type Project = { id: string; slug: string };
  type Route = {
    routeId: string;
    enabled: boolean;
    access: string;
    cacheTtl: number;
    datasetId: string;
    hitCount: number;
    lastError: string | null;
    definition: { path: string; method: string; query: { schema: string } };
  };

  const ops = readStudioOpsConfig();
  const projectSlug = localStorage.getItem("aurii.projectSlug");
  const projects = await api<{ data: Project[] }>("/api/projects");
  const project = projectSlug
    ? projects.data.find((p) => p.slug === projectSlug)
    : projects.data[0];
  const el = document.getElementById("list")!;

  function renderRoute(r: Route, slug: string): string {
    return `<tr>
      <td>${r.routeId}</td>
      <td><code>/public/${slug}/v1${r.definition.path}</code></td>
      <td>${r.definition.query.schema}</td>
      <td>${r.access}</td>
      <td>${r.enabled ? "yes" : "no"}</td>
      <td>${r.hitCount}</td>
      <td style="max-width:200px;font-size:12px;color:${r.lastError ? "var(--red)" : "inherit"}">${r.lastError ?? "—"}</td>
      <td>
        <button data-id="${r.routeId}" data-en="${r.enabled ? "0" : "1"}">
          ${r.enabled ? "Disable" : "Enable"}
        </button>
        <button data-test="${r.routeId}">Test</button>
      </td>
    </tr>`;
  }

  if (!project) {
    el.textContent = "No project selected.";
  } else {
    const res = await api<{ data: Route[] }>(`/api/projects/${project.id}/routes`);
    if (!res.data.length) {
      el.innerHTML = "<p class='muted'>No routes registered. Bootstrap the project package.</p>";
    } else {
      const grouped = groupItemsByIds(res.data, ops.routeGroups, (r) => r.routeId);
      el.innerHTML = grouped
        .map((g) => {
          const heading = g.title
            ? `<h3 class="ops-group-title">${g.title}</h3>`
            : "";
          return `${heading}<table><thead><tr>
            <th>Id</th><th>Path</th><th>Schema</th><th>Access</th><th>Enabled</th><th>Hits</th><th>Last error</th><th></th>
          </tr></thead><tbody>${g.items.map((r) => renderRoute(r, project.slug)).join("")}</tbody></table>`;
        })
        .join("");

      el.querySelectorAll("button[data-id]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const routeId = btn.getAttribute("data-id")!;
          const enabled = btn.getAttribute("data-en") === "1";
          await api(`/api/projects/${project.id}/routes/${routeId}`, {
            method: "PATCH",
            body: JSON.stringify({
              enabled,
              datasetId: getDataset(),
            }),
          });
          window.location.reload();
        });
      });
      el.querySelectorAll("button[data-test]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const routeId = btn.getAttribute("data-test")!;
          const result = await api<{ data: { data: unknown[] } }>(
            `/api/projects/${project.id}/routes/${routeId}/test`,
            { method: "POST", body: "{}" },
          );
          alert(`Rows: ${result.data.data.length}`);
        });
      });
    }
  }
</script>
